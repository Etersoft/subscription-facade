{{#> base title="Отписка от рассылки" }}
  {{#if unsubscribeSuccess}}
    {{#if text}}
      {{{ text }}}
    {{else}}
      <h1>Вы отписались</h1>
      <p>Адрес <span class='email'>{{ email }}</span> исключён из рассылки, писем из неё больше не будет.</p>
    {{/if}}
  {{else}}
    <h1>Не удалось отписаться</h1>
    {{#if email}}
      <p>Адрес <span class='email'>{{ email }}</span> не исключён из рассылки. Возможные причины:</p>
    {{else}}
      <p>Ссылка неполная: в ней нет адреса. Скопируйте её из письма целиком. Другие возможные причины:</p>
    {{/if}}
    <ul>
      <li>адрес не подписан на рассылку или уже отписан;</li>
      <li>рассылки больше нет.</li>
    </ul>
    <p class='muted'>Если письма продолжают приходить, напишите отправителю рассылки.</p>
  {{/if}}
{{/base}}
