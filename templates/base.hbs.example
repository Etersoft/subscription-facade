<!doctype html>
<html lang='ru'>
  <head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <meta name='color-scheme' content='light dark'>
    <title>{{ title }}</title>
    <style>
      :root {
        color-scheme: light dark;
      }

      body {
        background: #fff;
        color: #1a1a1a;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
        font-size: 17px;
        line-height: 1.55;
        margin: 0;
      }

      .main {
        margin: 0 auto;
        max-width: 600px;
        padding: 48px 16px;
      }

      h1 {
        font-size: 26px;
        line-height: 1.25;
        margin: 0 0 16px;
      }

      .email {
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      .muted {
        color: #595959;
      }

      ul {
        padding-left: 22px;
      }

      li + li {
        margin-top: 6px;
      }

      /* Тёмная тема по настройке браузера */
      @media (prefers-color-scheme: dark) {
        body {
          background: #1b1b1d;
          color: #e6e6e6;
        }

        .muted {
          color: #a6a6a6;
        }

        a {
          color: #6cb2ff;
        }
      }
    </style>
  </head>
  <body>
    <main class='main'>
      {{> @partial-block }}
    </main>
  </body>
</html>
