<!doctype html>
<html lang='ru'>
  <head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>{{ title }}</title>
    <style>
      body {
        background: #fff;
        color: #1a1a1a;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
        font-size: 17px;
        line-height: 1.55;
        margin: 0;
      }

      .main {
        margin: 0 auto;
        max-width: 600px;
        padding: 48px 16px;
      }

      h1 {
        font-size: 26px;
        line-height: 1.25;
        margin: 0 0 16px;
      }

      .email {
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      .muted {
        color: #595959;
      }

      ul {
        padding-left: 22px;
      }

      li + li {
        margin-top: 6px;
      }
    </style>
  </head>
  <body>
    <main class='main'>
      {{> @partial-block }}
    </main>
  </body>
</html>
