{
  "name": "subscription-facade",
  "version": "0.1.0",
  "description": "Server that controls user subscription",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test",
    "lint-fix": "eslint --fix src test",
    "start": "node dist/src/index.js",
    "test": "tsc && node --test 'dist/test/**/*.test.js'",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "watch-run": "node --watch-path=dist dist/src/index.js"
  },
  "author": "Dmitry Nikulin <theowl@etersoft.ru>",
  "private": true,
  "engines": {
    "node": ">=22.23.3"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-handlebars": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
